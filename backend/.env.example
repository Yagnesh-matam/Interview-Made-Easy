# Backend Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=5000

# Supabase project (Settings -> API). Used server-side to VERIFY user session JWTs.
# The anon/publishable key is safe here; it cannot write to the database by itself.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# AI Provider Keys (server-side only — never exposed to the browser)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Groq text-generation model used by the Adaptive Quiz (optional — the value below is the
# built-in default). Must be a PRODUCTION model your plan can actually call:
# https://console.groq.com/docs/models
# (llama-3.3-70b-versatile and llama-3.1-8b-instant are Enterprise-only as of Aug 2026.)
GROQ_MODEL_ID=openai/gpt-oss-120b

# CORS Configuration - comma-separated whitelist of frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://interview-made-easy.vercel.app
